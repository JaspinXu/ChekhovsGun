# ChekhovsGun — copy to .env and fill in what you need. Everything is optional:
# with no credentials at all you can still run `chekhovsgun demo`.

# ---------------------------------------------------------------- YouTube ---
# An API key reads public/unlisted playlists (Google Cloud → YouTube Data API v3).
CHEKHOVSGUN_YOUTUBE_API_KEY=
# An OAuth access token additionally reads Liked (LL) and Watch Later (WL).
CHEKHOVSGUN_YOUTUBE_OAUTH_TOKEN=
# Comma-separated playlist ids. Leave empty to use LL,WL when a token is set.
CHEKHOVSGUN_YOUTUBE_PLAYLISTS=

# --------------------------------------------------------------- Bilibili ---
# Copy from a logged-in bilibili.com tab: DevTools → Application → Cookies.
CHEKHOVSGUN_BILIBILI_SESSDATA=
CHEKHOVSGUN_BILIBILI_UID=
CHEKHOVSGUN_BILIBILI_JCT=
# Comma-separated 收藏夹 media_id or folder names. Empty = every folder.
CHEKHOVSGUN_BILIBILI_FOLDERS=

# -------------------------------------------------------------- Embeddings --
# local (default, no key needed) | openai | sentence-transformers
CHEKHOVSGUN_EMBEDDING_BACKEND=local
CHEKHOVSGUN_EMBEDDING_MODEL=
CHEKHOVSGUN_EMBEDDING_API_KEY=
# Any OpenAI-compatible endpoint works: DashScope, SiliconFlow, Ollama, vLLM…
CHEKHOVSGUN_EMBEDDING_BASE_URL=

# --------------------------------------------------------------------- LLM --
# Optional. Without a key the explanation falls back to quoting your transcript.
CHEKHOVSGUN_LLM_ENABLED=true
CHEKHOVSGUN_LLM_MODEL=gpt-4o-mini
CHEKHOVSGUN_LLM_API_KEY=
CHEKHOVSGUN_LLM_BASE_URL=
CHEKHOVSGUN_LLM_LANGUAGE=auto

# --------------------------------------------------- Whisper (no subtitles) --
# Needs: pip install -e ".[whisper]"  and ffmpeg on PATH. Audio never leaves the machine.
CHEKHOVSGUN_WHISPER_ENABLED=true
# tiny | base | small (default) | medium | large-v3
CHEKHOVSGUN_WHISPER_MODEL=small
CHEKHOVSGUN_WHISPER_DEVICE=auto
CHEKHOVSGUN_WHISPER_COMPUTE=int8
CHEKHOVSGUN_WHISPER_LANGUAGE=
# Skip anything longer than this, and stop transcribing after this much per sync.
CHEKHOVSGUN_WHISPER_MAX_DURATION=2700
CHEKHOVSGUN_WHISPER_BUDGET=1800

# ----------------------------------------------------------------- Comments --
CHEKHOVSGUN_COMMENTS_ENABLED=true
CHEKHOVSGUN_COMMENTS_MAX=15
CHEKHOVSGUN_COMMENTS_MIN_LIKES=3

# ------------------------------------------------------------------ Tuning --
CHEKHOVSGUN_HOST=127.0.0.1
CHEKHOVSGUN_PORT=8700
CHEKHOVSGUN_TOP_K_ITEMS=5
# Raise towards 0.45 if the popup fires too eagerly; lower towards 0.20 if it stays quiet.
CHEKHOVSGUN_MIN_CONFIDENCE=0.30
# Items you marked 已学完 stop firing. Set false if you want reminders anyway.
CHEKHOVSGUN_EXCLUDE_DIGESTED=true
# The popup waits until the library is this big. Below it, IDF is too noisy to
# tell a real match from a shared common word, so it would fire on coincidences.
# Search is never gated by this.
CHEKHOVSGUN_MIN_LIBRARY_ITEMS=15
